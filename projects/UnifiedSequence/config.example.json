{
  "schema_version": 1,
  "data": {
    "dataset_root": "./data/unified",
    "shuffle": true,
    "repeat": true,
    "seed": 1234
  },
  "tokenizer": {
    "pad_token_id": 0
  },
  "image": {
    "channels": 3,
    "encoder_width": 64,
    "target_weight": 1.0,
    "detach_targets": true
  },
  "model": {
    "vocab_size": 65536,
    "hidden_size": 1024,
    "target_mode": "causal"
  },
  "backbone": {
    "name": "kda",
    "hidden_size": 1024,
    "num_layers": 24,
    "num_heads": 16,
    "intermediate_size": 4096,
    "sink_tokens": 4,
    "expand_v": 1.0,
    "conv_size": 4,
    "mode": "chunk"
  },
  "runtime": {
    "dtype": "bfloat16",
    "grad_clip_norm": 1.0,
    "seed": 1234,
    "fsdp2": true,
    "fsdp_reshard_after_forward": false,
    "activation_checkpointing": true,
    "compile_model": false
  },
  "tbptt": {
    "chunk_length": 1024,
    "lane_count": 1,
    "tbptt_chunks": 10,
    "optimizer_step_chunks": 10,
    "max_atoms_per_step": null
  },
  "optimizer": {
    "name": "adamw",
    "learning_rate": 0.0003,
    "weight_decay": 0.1,
    "betas": [0.9, 0.95],
    "eps": 1e-8
  },
  "checkpoint": {
    "directory": "./checkpoints-unified",
    "every_optimizer_steps": 1000
  },
  "logging": {
    "directory": "./logs-unified",
    "every_optimizer_steps": 10,
    "tensorboard": true
  },
  "max_optimizer_steps": 100000
}
